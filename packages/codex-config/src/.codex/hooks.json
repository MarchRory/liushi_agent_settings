{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/node_modules/.bin/tsx\" \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.ts\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ((git rev-parse --show-toplevel) + '/node_modules/.bin/tsx.cmd') ((git rev-parse --show-toplevel) + '/.codex/hooks/pre_tool_use_policy.ts')\"",
            "timeout": 30,
            "statusMessage": "Checking tool policy"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/node_modules/.bin/tsx\" \"$(git rev-parse --show-toplevel)/.codex/hooks/permission_request_policy.ts\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ((git rev-parse --show-toplevel) + '/node_modules/.bin/tsx.cmd') ((git rev-parse --show-toplevel) + '/.codex/hooks/permission_request_policy.ts')\"",
            "timeout": 30,
            "statusMessage": "Checking approval policy"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "reviewer|tester|critic|architect|implementer|researcher|memory-curator|codebase-explorer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/node_modules/.bin/tsx\" \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_start_context.ts\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ((git rev-parse --show-toplevel) + '/node_modules/.bin/tsx.cmd') ((git rev-parse --show-toplevel) + '/.codex/hooks/subagent_start_context.ts')\"",
            "timeout": 30,
            "statusMessage": "Injecting specialist contract"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "reviewer|tester|critic|architect|implementer|researcher|memory-curator|codebase-explorer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/node_modules/.bin/tsx\" \"$(git rev-parse --show-toplevel)/.codex/hooks/subagent_stop_schema_gate.ts\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ((git rev-parse --show-toplevel) + '/node_modules/.bin/tsx.cmd') ((git rev-parse --show-toplevel) + '/.codex/hooks/subagent_stop_schema_gate.ts')\"",
            "timeout": 30,
            "statusMessage": "Checking specialist output"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/node_modules/.bin/tsx\" \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_validation_gate.ts\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& ((git rev-parse --show-toplevel) + '/node_modules/.bin/tsx.cmd') ((git rev-parse --show-toplevel) + '/.codex/hooks/stop_validation_gate.ts')\"",
            "timeout": 30,
            "statusMessage": "Checking final response"
          }
        ]
      }
    ]
  }
}
