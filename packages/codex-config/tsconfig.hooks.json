{
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "rootDir": "src/.codex/hooks",
    "strict": true,
    "target": "ES2023",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src/.codex/hooks/**/*.ts"]
}
