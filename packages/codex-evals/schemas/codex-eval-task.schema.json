{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex-only eval task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "suite",
    "category",
    "prompt",
    "expected_agents",
    "forbidden_agents",
    "acceptable_strategies",
    "rubric_ref",
    "must_include",
    "must_not_include",
    "target_surface",
    "claim_scope",
    "dataset_visibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "suite": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "routing",
        "per-agent",
        "adversarial"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 24
    },
    "expected_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptable_strategies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "rubric_ref": {
      "type": "string"
    },
    "must_include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "must_not_include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_surface": {
      "type": "string",
      "enum": [
        ".codex"
      ]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "readiness",
        "routing_oracle",
        "safety_regression",
        "live_ab_required"
      ]
    },
    "dataset_visibility": {
      "type": "string",
      "enum": [
        "visible_dev_set",
        "sealed_holdout"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  }
}
