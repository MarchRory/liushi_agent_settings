{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex-only eval summary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_type",
    "timestamp",
    "configuration",
    "evaluated_surface",
    "claim_scope",
    "dataset_visibility",
    "live_model_used",
    "llm_judge",
    "output_policy",
    "scores",
    "score_interpretation",
    "metrics",
    "failures",
    "does_not_prove",
    "final_status"
  ],
  "properties": {
    "run_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "configuration": {
      "type": "string"
    },
    "evaluated_surface": {
      "type": "string",
      "enum": [
        ".codex"
      ]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "deterministic_readiness_only",
        "deterministic_smoke_only"
      ]
    },
    "dataset_visibility": {
      "type": "string",
      "enum": [
        "visible_dev_set",
        "sealed_holdout"
      ]
    },
    "live_model_used": {
      "type": "boolean",
      "const": false
    },
    "llm_judge": {
      "type": "string",
      "enum": [
        "disabled"
      ]
    },
    "output_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_outputs_ignored",
        "default_output_dir",
        "reports_committed_by_default"
      ],
      "properties": {
        "generated_outputs_ignored": {
          "type": "boolean",
          "const": true
        },
        "default_output_dir": {
          "type": "string"
        },
        "reports_committed_by_default": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "score_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denominator",
        "behavioral_quality_score",
        "non_behavioral_metric_share",
        "excluded_claims_field"
      ],
      "properties": {
        "denominator": {
          "type": "string"
        },
        "behavioral_quality_score": {
          "type": "boolean",
          "const": false
        },
        "non_behavioral_metric_share": {
          "type": "number",
          "const": 1
        },
        "excluded_claims_field": {
          "type": "string",
          "const": "does_not_prove"
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "does_not_prove": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_status": {
      "type": "string",
      "enum": [
        "pass",
        "review_required",
        "fail"
      ]
    }
  }
}
