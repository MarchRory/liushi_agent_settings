{
  "name": "@liushi-agent-settings/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-harness": "bin/agent-harness.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src"
  ],
  "scripts": {
    "check": "node bin/agent-harness.mjs check --delete-extra=true --target ../.. --adapter ../codex-config",
    "eval:live-model-ab": "node scripts/run-live-model-ab.mjs",
    "sync": "node bin/agent-harness.mjs sync --write --delete-extra=true --target ../.. --adapter ../codex-config",
    "test:sync-cli": "node tests/sync-cli.test.mjs",
    "validate:static": "node scripts/validate-static.mjs"
  }
}
