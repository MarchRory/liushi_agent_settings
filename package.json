{
  "name": "liushi-agent-settings-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/harness",
    "packages/codex-config",
    "packages/codex-evals",
    "packages/harness/src/.agents/skills/multi-agent-orchestration"
  ],
  "scripts": {
    "sync": "node packages/harness/bin/agent-harness.mjs sync --write --delete-extra=true --target . --adapter packages/codex-config",
    "check:sync": "node packages/harness/bin/agent-harness.mjs check --delete-extra=true --target . --adapter packages/codex-config",
    "eval:live-model-ab": "node packages/harness/scripts/run-live-model-ab.mjs",
    "eval:codex:validate": "npm --workspace @liushi-agent-settings/codex-evals run validate",
    "eval:codex:static": "npm --workspace @liushi-agent-settings/codex-evals run static",
    "eval:codex:smoke": "npm --workspace @liushi-agent-settings/codex-evals run smoke",
    "eval:codex:dashboard": "npm --workspace @liushi-agent-settings/codex-evals run dashboard",
    "test:sync-cli": "node packages/harness/tests/sync-cli.test.mjs",
    "validate": "npm run check:sync && npm run test:sync-cli && npm run validate:static && npm run validate:orchestration",
    "validate:static": "node packages/harness/scripts/validate-static.mjs",
    "validate:orchestration": "npm --workspace multi-agent-orchestration-skill run typecheck && npm --workspace multi-agent-orchestration-skill run validate && npm --workspace multi-agent-orchestration-skill run examples && npm --workspace multi-agent-orchestration-skill run fixtures && npm --workspace multi-agent-orchestration-skill run wrappers"
  }
}
