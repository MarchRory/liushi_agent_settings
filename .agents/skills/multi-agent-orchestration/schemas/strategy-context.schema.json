{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/liushi-agent-settings/strategy-context.schema.json",
  "title": "StrategyContext",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "task": { "type": "string" },
    "task_summary": { "type": "string" },
    "task_type": {
      "type": "string",
      "enum": [
        "small_fix",
        "pr_review",
        "architecture_decision",
        "external_research",
        "memory_update",
        "high_risk_operation"
      ]
    },
    "complexity": { "type": "integer", "minimum": 1, "maximum": 5 },
    "risk": { "type": "integer", "minimum": 1, "maximum": 5 },
    "parallelizable": { "type": "boolean" },
    "requires_external_sources": { "type": "boolean" },
    "requires_code_changes": { "type": "boolean" },
    "requires_tests": { "type": "boolean" },
    "has_competing_options": { "type": "boolean" },
    "has_decision_criteria": { "type": "boolean" },
    "user_requested_debate": { "type": "boolean" },
    "user_requested_agents": { "type": "array", "items": { "type": "string" } },
    "available_evidence": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } }
  },
  "anyOf": [
    { "required": ["task"] },
    { "required": ["task_summary"] }
  ]
}
